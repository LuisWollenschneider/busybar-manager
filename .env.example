# Copy to .env next to docker-compose.yml. Every value below is optional —
# `docker compose up -d` works with no .env at all and uses these defaults.
#
#   cp .env.example .env

# --- Where the dashboard is published on the host ---------------------------

# Host interface the container port is bound to.
#   127.0.0.1  loopback only (default) — reachable from this machine only
#   0.0.0.0    every interface — reachable from the LAN
#   <ip>       one specific interface, e.g. 192.168.1.50
#
# WARNING: the manager dashboard has NO authentication. Anyone who can reach
# this port gets full control: install/run apps, edit config, read the BusyBar
# and cloud tokens, and proxy requests to the bar. Only leave loopback if the
# network is trusted, or put a reverse proxy with auth in front of it.
BUSYBAR_PUBLISH_HOST=127.0.0.1

# Host-side port. The container always listens on 8321 internally; this only
# changes the outside port, so BUSYBAR_PUBLISH_PORT=9000 means
# http://<host>:9000.
BUSYBAR_PUBLISH_PORT=8321

# --- Time zone --------------------------------------------------------------

# Wall-clock timezone inside the container, as an IANA zone name. The base
# image runs in UTC, which affects two things:
#   * apps that render local time (clock, calendar, …) draw the UTC hour
#   * schedule slots are matched against the container's local time, so a
#     "18:00-20:00" slot starts at 18:00 UTC
# Set this to your own zone to fix both. DST is handled by the zone itself, so
# Europe/Berlin covers CET and CEST — do not hardcode a fixed offset.
#
# Takes effect on `docker compose up -d` (container recreate); already-running
# apps pick it up when they are restarted.
#TZ=Europe/Berlin

# --- Container runtime ------------------------------------------------------
# These are already set in docker-compose.yml; uncomment to override.

# Interface the server binds to *inside* the container. Must stay 0.0.0.0 —
# a loopback bind inside the container is unreachable from a published port.
#BUSYBAR_BIND_HOST=0.0.0.0

# Config file path inside the container. Lives under the ./docker/data bind
# mount so it survives a rebuild.
#BUSYBAR_MANAGER_CONFIG=/data/config.json

# Python interpreter used to build each app's virtualenv.
#BUSYBAR_PYTHON=python3

# API base URLs — only needed to point at a staging backend.
#BUSYBAR_CLOUD_API_BASE=https://api.busy.app/busybar
#BUSYBAR_LIBRARY_API_BASE=https://api.github.com
#BUSYBAR_LIBRARY_RAW_BASE=https://raw.githubusercontent.com
